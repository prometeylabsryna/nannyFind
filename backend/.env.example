# === Development (локально) ===
DJANGO_SETTINGS_MODULE=config.settings.develop
SECRET_KEY=dev-only-insecure-key-do-not-use-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

DB_NAME=pomich_poruch
DB_USER=pomich
DB_PASSWORD=pomich
DB_HOST=localhost
DB_PORT=5433

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8082,http://127.0.0.1:8082
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8082,http://127.0.0.1:8082
FRONTEND_URL=http://localhost:8082
BACKEND_URL=http://localhost:8001

# OAuth — кнопки активуються автоматично після заповнення
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# Платежі — auto: stub без ключів; false на проді з реальними ключами
PAYMENTS_STUB_MODE=auto
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
FONDY_MERCHANT_ID=
FONDY_SECRET_KEY=

# Email через Resend (https://resend.com) — обовʼязково на проді для скидання пароля.
# Без RESEND_API_KEY лист не відправляється реально, лише пишеться в лог (ок для dev).
DEFAULT_FROM_EMAIL=noreply@pomich-poruch.com.ua
RESEND_API_KEY=

# Seed лише для dev: RUN_SEED_DEMO=true ./entrypoint.sh
RUN_SEED_DEMO=false
ADMIN_EMAIL=admin@pomich-poruch.com.ua
ADMIN_PASSWORD=change-me-before-production

# ============================================================
# === Production (DigitalOcean, docker-compose.prod.yml) ===
# Скопіювати цей блок у backend/.env на сервері, розкоментувати,
# підставити реальні значення. Докладна інструкція — DEPLOY.md.
# ============================================================
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=False
# SECRET_KEY=<згенерувати: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
#
# Фронтенд — pomich-poruch.com.ua (+www), Django/admin/API — окремий
# піддомен api.pomich-poruch.com.ua (щоб не конфліктувати зі своєю /admin/
# JS-панеллю на головному домені).
# ALLOWED_HOSTS=pomich-poruch.com.ua,www.pomich-poruch.com.ua,api.pomich-poruch.com.ua,backend,localhost,127.0.0.1
# FRONTEND_URL=https://pomich-poruch.com.ua
# BACKEND_URL=https://api.pomich-poruch.com.ua
# CORS_ALLOWED_ORIGINS=https://pomich-poruch.com.ua,https://www.pomich-poruch.com.ua
# CSRF_TRUSTED_ORIGINS=https://pomich-poruch.com.ua,https://www.pomich-poruch.com.ua,https://api.pomich-poruch.com.ua
#
# nginx-контейнер сам термінує TLS і завжди шле X-Forwarded-Proto: https,
# тож Django НЕ повинен ще раз редіректити (інакше internal healthcheck/
# proxy-запити зациклюються на 301). Тримати False, доки TLS у nginx.
# SECURE_SSL_REDIRECT=False
#
# === PostgreSQL (значення мають збігатися з DB_NAME/DB_USER/DB_PASSWORD вище) ===
# POSTGRES_DB=pomich_poruch
# POSTGRES_USER=pomich
# POSTGRES_PASSWORD=<сильний-пароль>
# DB_NAME=pomich_poruch
# DB_USER=pomich
# DB_PASSWORD=<той-самий-сильний-пароль>
#
# === Платежі (LiqPay/WayForPay/Fondy) — залишити auto, доки немає реальних ключів ===
# PAYMENTS_STUB_MODE=auto
#
# === Email (Resend) — без цього не працює "забув пароль" ===
# RESEND_API_KEY=re_...
# DEFAULT_FROM_EMAIL=noreply@pomich-poruch.com.ua (домен має бути верифікований у Resend)
#
# === Seed ===
# RUN_SEED_DEMO=false
# ADMIN_EMAIL=admin@pomich-poruch.com.ua
# ADMIN_PASSWORD=<згенерувати сильний пароль>
